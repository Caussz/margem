---
import Base from './Base.astro';
import { dataCurta, dataISO } from '../data';

interface Props {
  titulo: string;
  resumo: string;
  data: Date;
  atualizado?: Date;
  tags?: string[];
}

const { titulo, resumo, data, atualizado, tags = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Base titulo={titulo} descricao={resumo}>
  <div class="envelope">
    <article class="casca">
      <!-- Coluna de margem: data, revisão, assuntos -->
      <aside class="margem" aria-label="Informações do texto">
        <div class="bloco">
          <dl>
            <dt>Publicado</dt>
            <dd><time datetime={dataISO(data)}>{dataCurta(data)}</time></dd>
          </dl>
        </div>
        {atualizado && (
          <div class="bloco">
            <dl>
              <dt>Revisado</dt>
              <dd><time datetime={dataISO(atualizado)}>{dataCurta(atualizado)}</time></dd>
            </dl>
          </div>
        )}
        {tags.length > 0 && (
          <div class="bloco">
            <dl>
              <dt>Assuntos</dt>
              <dd>{tags.join(', ')}</dd>
            </dl>
          </div>
        )}
      </aside>

      <div class="corpo">
        <header class="cabeca-artigo">
          <h1>{titulo}</h1>
          <p class="resumo">{resumo}</p>
        </header>

        <div class="prosa">
          <slot />
        </div>

        <footer class="pe-artigo">
          <a href={base}>← Todas as anotações</a>
        </footer>
      </div>
    </article>
  </div>
</Base>
