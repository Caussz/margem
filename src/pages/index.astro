---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import { dataCurta, dataISO, porData } from '../data';

const base = import.meta.env.BASE_URL;
const producao = import.meta.env.PROD;

// Em produção, esconde rascunhos. Em dev, mostra tudo.
const artigos = (await getCollection('artigos'))
  .filter((a) => !producao || !a.data.rascunho)
  .sort(porData);

function href(id: string) {
  return `${base.replace(/\/$/, '')}/artigos/${id}`;
}
---

<Base>
  <div class="envelope">
    <section class="casca">
      <div class="margem" aria-hidden="true">
        <div class="bloco">
          <dl>
            <dt>Desde</dt>
            <dd>2026</dd>
          </dl>
        </div>
        <div class="bloco">
          <dl>
            <dt>Anotações</dt>
            <dd>{artigos.length}</dd>
          </dl>
        </div>
      </div>

      <div class="corpo">
        <div class="rosto">
          <p class="sobrescrito">Caderno de engenharia de software</p>
          <h1>Escrevo aqui pra <em>pensar</em> melhor.</h1>
          <p class="intro">
            Notas sobre problemas que resolvi, decisões que ainda estou
            remoendo e coisas que só ficam claras quando preciso
            explicá-las. Publicado sem pressa ou vontade de acertar de primeira.
          </p>
        </div>

        <section class="log" aria-label="Anotações">
          <h2 class="log-titulo">O log</h2>

          {artigos.length === 0 && (
            <p class="vazio">Nada por aqui ainda. A primeira anotação vem logo.</p>
          )}

          {artigos.map((a) => (
            <article class="entrada">
              <time class="entrada-data" datetime={dataISO(a.data.data)}>
                {dataCurta(a.data.data)}
              </time>
              <div class="entrada-corpo">
                <h3 class="entrada-titulo">
                  <a href={href(a.id)}>{a.data.titulo}</a>
                  {a.data.rascunho && <span class="rascunho-selo">rascunho</span>}
                </h3>
                <p class="entrada-resumo">{a.data.resumo}</p>
                {a.data.tags.length > 0 && (
                  <div class="entrada-tags">
                    {a.data.tags.map((t) => <span class="tag">{t}</span>)}
                  </div>
                )}
              </div>
            </article>
          ))}
        </section>
      </div>
    </section>
  </div>
</Base>
